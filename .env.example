OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# Legacy option affects the dialogue role only; it never disables DeepSeek reasoning.
OPENAI_DISABLE_THINKING=1
OPENAI_REASONING_THINKING=1
OPENAI_DIALOGUE_THINKING=0
# Total wall-clock deadline for each non-streaming model call, including keepalive time.
OPENAI_REASONING_DEADLINE_SECONDS=240
# Whole-book synthesis has a separate wall-clock budget; live replies do not wait for it.
OPENAI_SYNTHESIS_DEADLINE_SECONDS=600
RUN_REAL_AI_TESTS=0

OPENAI_REASONING_MODEL=deepseek-v4-pro
OPENAI_DIALOGUE_MODEL=deepseek-flash

# Explicit preprocessing budget. Increasing this increases model calls and cost.
# Sections: 12000 chars for small material, 24000 for books over 120000 chars.
LINGUALOOP_MAX_MATERIAL_CHARS=1000000
# Concurrent section analysis (1-4); each completed section is saved immediately.
LINGUALOOP_PREPARATION_CONCURRENCY=3
# Total deadline per material-analysis run; completed chunks survive timeout/retry.
LINGUALOOP_PREPARATION_DEADLINE_SECONDS=1800

# Speech services are configured independently from the text provider.
# Use model/voice IDs and OpenAI-compatible audio endpoints your service supports.
LINGUALOOP_STT_BASE_URL=
LINGUALOOP_STT_API_KEY=
LINGUALOOP_STT_MODEL=
LINGUALOOP_TTS_BASE_URL=
LINGUALOOP_TTS_API_KEY=
LINGUALOOP_TTS_MODEL=
LINGUALOOP_TTS_VOICE=

# Optional localhost LiveKit probe: install the `realtime` extra and run
# scripts/probe_livekit.py. It does not read .env, requires no cloud credentials,
# and generates ephemeral room credentials itself. Do not ship server secrets
# or long-lived provider keys to future desktop RTC clients.

# Optional database directory (default: platform application data).
LINGUALOOP_DATA_DIR=
